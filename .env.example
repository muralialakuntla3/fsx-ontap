# FSx for ONTAP management endpoint.
# Use the SVM management LIF/DNS name reachable from this container.
ONTAP_HOST=management.fs-0fe7734e83333a374.fsx.us-east-1.amazonaws.com

# ONTAP account with permission to manage CIFS local groups.
ONTAP_USERNAME=fsxadmin
ONTAP_PASSWORD=change-me

# Set false only for a lab when your ONTAP certificate is not trusted.
ONTAP_VERIFY_SSL=false

# Optional.
DEFAULT_SVM=cape-test

ONTAP_TIMEOUT=30
APP_TITLE=FSx ONTAP Local Group Manager
